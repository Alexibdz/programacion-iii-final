# Configuración local 
.env

# Dependencias de Composer
/vendor/

# Archivos temporales generados por CodeIgniter
/writable/cache/*
!/writable/cache/index.html
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html
/writable/debugbar/*
!/writable/debugbar/index.html

# Archivos del sistema operativo y del editor
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
